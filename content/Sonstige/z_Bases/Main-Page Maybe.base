filters:
  and:
    - folderNote == true
formulas:
  Untitled: ""
  Neu: link(file.path, file.folder.replace(/.*\//, ""))
  Untitled 2: html('<span style="background:#7a2e2e;color:#fff;padding:2px 6px;border-radius:4px">' + note.kategorie + '</span>')
  Wikilink für Quartz: '"[[" + file.path.replace(".md", "") + "|" + file.folder.replace(/.*\//, "") + "]]"'
  card_link: card_link
properties:
  formula.Neu:
    displayName: Card-Name
  formula.Untitled 2:
    displayName: Badge
  formula.card_link:
    displayName: Übersicht
views:
  - type: cards
    name: Karten
    filters:
      and:
        - file.folder.contains("Compass")
        - '!file.name.contains("Compass")'
        - folderNote == true
    order:
      - formula.Neu
    sort:
      - property: file.folder
        direction: ASC
    imageAspectRatio: 1
    cardSize: 190
    rowHeight: medium
    image: note.Cover
  - type: table
    name: Tabelle
    filters:
      and:
        - folderNote == true
        - file.folder.contains("Compass")
        - '!file.name.contains("Compass")'
    order:
      - formula.card_link
    sort:
      - property: file.folder
        direction: ASC
