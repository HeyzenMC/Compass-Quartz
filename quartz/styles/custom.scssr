/* Repariert die Infoboxen / Callouts */
.callout[data-callout="infobox"] {
  /* Verhindert die Transparenz - nutzt die Quartz-Standard-Hintergrundfarbe */
  background-color: var(--light) !important; 

/* Entfernt die blauen Akzentstriche */
  border: none !important; 
  border-left: none !important;
  
  /* Verhindert, dass Text und Linien in die Box rutschen */
  z-index: 10;
  margin-top: 1.5em;
  margin-bottom: 1.5em;
  padding: 0.2em;
}
/* Blendet die kaputten blauen Icon-Striche komplett aus */
.callout[data-callout="infobox"] .callout-icon {
  display: none !important;
}

/* Blendet das Kettensymbol (Anker-Link) bei Überschriften innerhalb von Infoboxen aus */
.callout[data-callout="infobox"] a[role="anchor"] {
  display: none !important;
}

/* ===== Individuelle Hex-Farben pro Infobox ===== */

.callout.callout[data-callout~=infobox] {
  background: transparent;
}

.callout.callout[data-callout~=infobox] > .callout-content {
  padding: 0;
}

.callout.callout[data-callout~=infobox] > .callout-content > .infobox-color {
  display: block;
  background-color: color-mix(in srgb, var(--infobox-accent) 10%, transparent);
  border: 1px solid #000000;
  --outer-bar: color-mix(in srgb, var(--infobox-accent, var(--background-secondary)) 30%, var(--background-primary) 70%);
}

.callout.callout[data-callout~=infobox] > .callout-content > .infobox-color > :is(h1, h2, h3, h4, h5, h6) {
  font-size: 20px;
  font-family: Cinzel, serif !important;
  text-align: center;
  margin: 0px;
  color: var(--text-normal);
  background: var(--outer-bar, var(--background-secondary));
  border-bottom-width: 1px;
  border-top-width: 1px;
}

.callout.callout[data-callout~=infobox] > .callout-content > .infobox-color table th {
  color: var(--infobox-header-color) !important;
}

/* --- TRENNLINIEN ZWISCHEN DEN ZEILEN --- */
/* Zwingt die Zellen (td) und den Kopf (th), eine Linie in deiner Wunschfarbe zu zeichnen */
.callout.callout[data-callout~=infobox] > .callout-content > .infobox-color table td,
.callout.callout[data-callout~=infobox] > .callout-content > .infobox-color table th {
  border-bottom: 1px solid var(--infobox-border-color, transparent) !important;
  border-left: 0px solid var(--infobox-border-color, transparent) !important;
  border-right: 0px solid var(--infobox-border-color, transparent) !important;
  border-top: 1px solid var(--infobox-border-color, transparent) !important;
}

/* --- ZEBRA-MUSTER (ABWECHSELNDE ZEILEN) ANPASSEN --- */
/* Überschreibt die automatische, bräunliche Hintergrundfarbe für jede zweite Zeile */
.callout.callout[data-callout~=infobox] > .callout-content > .infobox-color table {
  --table-row-alt-background: var(--infobox-alt-bg, transparent) !important;
}
.callout.callout.callout.callout:is([data-callout-metadata~=s-t],
[data-callout-metadata~=show-title]) > .callout-title {
  display: flex;
}
.callout.callout.callout.callout:is([data-callout-metadata~=s-t],
[data-callout-metadata~=show-title]) > .callout-content > p {
  margin-top: 0;
}
.callout-title > .callout-title-inner > p {
  color: #000000;
}

